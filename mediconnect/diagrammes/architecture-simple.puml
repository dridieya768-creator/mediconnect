@startuml
title Architecture MediConnect - Vue Simplifiée

skinparam componentStyle rectangle
skinparam linetype ortho

package "FRONTEND - Angular 17" {
  component "Components\n(View + ViewModel)" as comp {
    [patient-dashboard]
    [appointment-form]
    [medecin-profile]
  }
  
  component "Services" as frontSvc {
    [appointments.service]
    [auth.service]
    [medecins.service]
  }
  
  component "Models" as models {
    interface Appointment
    interface Patient
    interface Medecin
  }
  
  comp -down-> frontSvc : utilise
  frontSvc -down-> models : utilise
}

package "BACKEND - NestJS" {
  component "Controllers" as ctrl {
    [AppointmentsController]
    [PatientsController]
    [MedecinsController]
    [AuthController]
  }
  
  component "Services" as svc {
    [AppointmentsService]
    [PatientsService]
    [MedecinsService]
    [NotificationsService]
  }
  
  component "Repositories" as repo {
    [AppointmentRepository]
    [PatientRepository]
    [MedecinRepository]
  }
  
  component "Entities" as entity {
    class Appointment
    class Patient
    class Medecin
  }
  
  ctrl -down-> svc : appelle
  svc -down-> repo : utilise
  repo -down-> entity : manipule
}

database "PostgreSQL" {
  [appointments]
  [patients]
  [medecins]
  [users]
}

cloud "Services Externes" {
  [Email (SMTP)]
  [SMS (Twilio)]
  [WebRTC]
}

' Connexions principales
frontSvc -down-> ctrl : HTTP REST\nJSON + JWT
entity -down-> appointments : TypeORM
entity -down-> patients : SQL
entity -down-> medecins : Queries
svc -right-> Email : Nodemailer
svc -right-> SMS : API
comp -right-> WebRTC : P2P

note right of comp
  **MVVM Pattern**
  - View (HTML Template)
  - ViewModel (Component TS)
  - Data Binding
  - Reactive Forms
end note

note right of ctrl
  **Controller-Service-Repository**
  - Controller : Routes HTTP
  - Service : Logique métier
  - Repository : Accès données
  - Entity : Modèle ORM
end note

note bottom of PostgreSQL
  **Base de données relationnelle**
  - Tables normalisées
  - Contraintes d'intégrité
  - Transactions ACID
  - Indexes optimisés
end note

@enduml
