@startuml
title Architecture en Couches - MediConnect

skinparam linetype ortho

package "Couche Présentation" <<Rectangle>> {
  
  package "Frontend Angular" {
    component "Components" as comp {
      [patient-dashboard.component]
      [appointment-form.component]
      [medecin-profile.component]
    }
    
    component "Templates HTML" as templates {
      [patient-dashboard.html]
      [appointment-form.html]
    }
    
    component "Styles" as styles {
      [SCSS/CSS]
    }
  }
  
  package "Backend Controllers" {
    component "HTTP Controllers" as controllers {
      [AppointmentsController]
      [PatientsController]
      [MedecinsController]
      [AuthController]
    }
  }
}

package "Couche Application" <<Rectangle>> {
  
  package "Frontend Services" {
    component "Services Angular" as angServices {
      [AppointmentsService]
      [AuthService]
      [BookingStateService]
    }
  }
  
  package "Backend Services" {
    component "Business Services" as bizServices {
      [AppointmentsService]
      [PatientsService]
      [MedecinsService]
      [NotificationsService]
      [EmailService]
    }
  }
  
  component "DTOs" as dtos {
    [CreateAppointmentDto]
    [LoginDto]
    [RegisterDto]
  }
}

package "Couche Domaine" <<Rectangle>> {
  
  component "Models Frontend" as frontModels {
    interface "Appointment"
    interface "Patient"
    interface "Medecin"
  }
  
  component "Entities Backend" as entities {
    class "Appointment Entity"
    class "Patient Entity"
    class "Medecin Entity"
    class "User Entity"
  }
  
  component "Business Rules" as rules {
    [Validation métier]
    [Règles de gestion]
    [Contraintes]
  }
}

package "Couche Infrastructure" <<Rectangle>> {
  
  component "Repositories" as repos {
    [AppointmentRepository]
    [PatientRepository]
    [MedecinRepository]
  }
  
  component "TypeORM" as typeorm {
    [QueryBuilder]
    [EntityManager]
    [Migrations]
  }
  
  component "External Services" as external {
    [SMTP (Nodemailer)]
    [SMS (Twilio)]
    [Storage (Upload)]
  }
}

database "Base de Données" {
  [PostgreSQL]
  [Tables]
  [Indexes]
  [Constraints]
}

' Relations verticales (flux de données)
comp -down-> angServices : appelle
templates -down-> comp : data binding
controllers -down-> bizServices : appelle
angServices -down-> controllers : HTTP REST

bizServices -down-> entities : manipule
bizServices -down-> rules : applique
bizServices -down-> repos : utilise

repos -down-> typeorm : utilise
typeorm -down-> PostgreSQL : SQL

bizServices -right-> external : utilise

' Relations horizontales
comp -right-> frontModels : utilise
controllers -right-> dtos : valide
entities -left-> frontModels : correspond

note right of comp
  **MVVM Pattern**
  - View (HTML)
  - ViewModel (Component)
  - Data Binding
end note

note right of controllers
  **Controller Pattern**
  - Routes HTTP
  - Validation DTOs
  - Délégation aux Services
end note

note right of bizServices
  **Service Pattern**
  - Logique métier
  - Orchestration
  - Transactions
end note

note right of repos
  **Repository Pattern**
  - Abstraction données
  - CRUD operations
  - Requêtes complexes
end note

@enduml
